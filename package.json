{
  "name": "donkey-trump-race",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @dtr/server --filter @dtr/client-web dev",
    "build": "pnpm --filter @dtr/client-web build && pnpm --filter @dtr/server build",
    "start": "node packages/server/dist/main.js",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project dom",
    "test:e2e": "playwright test",
    "sprites": "node tools/extract-sprites.mjs",
    "test:integration": "vitest run --project integration",
    "test:a11y": "vitest run --project dom a11y && playwright test --grep @a11y",
    "test:keyboard": "playwright test --grep @keyboard",
    "fixtures:regenerate": "tsx scripts/fixtures/regenerate.ts && prettier --write --log-level warn \"packages/*/test/fixtures/**/*.json\"",
    "beta:summary": "tsx scripts/beta/summary.ts",
    "smoke:staging": "tsx scripts/smoke/staging-smoke.ts",
    "soak:multiplayer": "tsx scripts/soak/multiplayer-soak.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
